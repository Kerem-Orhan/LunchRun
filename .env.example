# Frontend (safe to expose — Supabase anon key is public by design; RLS protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only (Vercel env var — NEVER prefix with VITE_, or it ends up in the browser bundle)
ORS_API_KEY=your-openrouteservice-key
